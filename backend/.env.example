# Database (Render free PostgreSQL — copy the External Database URL from the Render dashboard)
# Local dev: postgresql://hoverai:hoverai@localhost:5432/hoverai_dev
# Schema is managed by Alembic: run `uv run alembic upgrade head` after changing this.
DATABASE_URL=postgresql://user:password@host:5432/hoverai

# JWT — generate a strong random secret (e.g. `openssl rand -hex 32`)
JWT_SECRET=change-me-minimum-32-chars
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=15
JWT_REFRESH_EXPIRE_DAYS=90

# Intron — used for Sahara TTS and Sahara streaming STT
# Your hackathon access token (from the registration email) IS this value.
# "Access token" and "API key" mean the same thing — it goes in Authorization: Bearer <value>
INTRON_API_KEY=your-intron-hackathon-access-token
INTRON_STT_BASE_URL=https://infer.voice.intron.io

# Groq — Whisper STT + vision LLM + Orpheus TTS
# Get your key at: https://console.groq.com
GROQ_API_KEY=your-groq-key

# Model names (change here to swap models without touching code)
VISION_MODEL=qwen/qwen3.8-27b
WHISPER_MODEL=whisper-large-v3

# Vision grounding: request JSON mode (auto-falls back if the model rejects it),
# and the long-edge cap for set-of-marks screenshots (mark numbers must stay legible)
VISION_JSON_MODE=true
VISION_MARKED_MAX_EDGE=1280

# TTS — Groq Orpheus (en/fr + fallback) and Intron Sahara (African languages)
TTS_MODEL=canopylabs/orpheus-v1-english
TTS_VOICE=autumn
TTS_ENABLED=true
SAHARA_TTS_ENABLED=true
# Seconds each TTS provider may take before we give up (Sahara, then Orpheus)
TTS_TIMEOUT_S=8

# Sahara streaming STT for African languages (off = Groq Whisper only)
SAHARA_STT_STREAM_ENABLED=false

# Server
PORT=8000
LOG_LEVEL=INFO

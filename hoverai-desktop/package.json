{
  "name": "hoverai-desktop",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "typecheck": "tsc --noEmit",
    "build:win": "pnpm typecheck && tauri build --target x86_64-pc-windows-msvc",
    "build:mac": "pnpm typecheck && tauri build --target aarch64-apple-darwin",
    "build:linux": "pnpm typecheck && tauri build --target x86_64-unknown-linux-gnu",
    "build:fast": "pnpm typecheck && tauri build --target x86_64-pc-windows-msvc -- --profile release-fast"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "@tauri-apps/plugin-store": "^2",
    "@tauri-apps/plugin-global-shortcut": "^2",
    "@tauri-apps/plugin-autostart": "^2",
    "@tauri-apps/plugin-shell": "^2",
    "framer-motion": "^13.2.0",
    "remixicon": "^4.9.1",
    "tailwindcss": "^4.3.3",
    "@tailwindcss/vite": "^4.3.3"
  },
  "devDependencies": {
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^6.0.2",
    "typescript": "~6.0.3",
    "vite": "^8.0.16",
    "@tauri-apps/cli": "^2"
  }
}
